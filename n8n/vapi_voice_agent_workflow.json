      "parameters": {
        "jsCode": "let lead = {};\ntry {\n  const inputData = $input.first().json.body.message?.toolCalls?.[0]?.function?.args?.datos_lead || $input.first().json.body.datos_lead;\n  lead = typeof inputData === 'string' ? JSON.parse(inputData) : inputData;\n} catch (e) {\n  console.error(\"Error parsing datos_lead:\", e);\n}\n\nreturn [{\n  json: {\n    nombre_padre: lead?.nombre_padre || 'Interesado',\n    nombre_niño: lead?.nombre_niño || lead?.nombre_nino || 'Paciente Nuevo',\n    telefono: lead?.telefono || ($input.first().json.body.message?.toolCalls?.[0]?.function?.args?.telefono_origen || $input.first().json.body.message?.customer?.number || $input.first().json.body.telefono_origen || '').toString().slice(-9),\n    motivo: lead?.motivo || lead?.notas || lead?.observaciones || 'No especificado'\n  }\n}];"
      },
