    {
      "parameters": {
        "jsCode": "const newItems = [];\nfor (let item of $input.all()) {\n  let newItem = JSON.parse(JSON.stringify(item.json));\n  try {\n    let toolCall = newItem.body?.message?.toolCalls?.[0];\n    if (toolCall && toolCall.function && toolCall.function.arguments) {\n      let argsStr = toolCall.function.arguments;\n      let args = typeof argsStr === 'string' ? JSON.parse(argsStr) : argsStr;\n      \n      // Normalizar nombre de terapeuta para base de datos (con tildes correctas)\n      if (args.terapeuta) {\n        let t = args.terapeuta.toLowerCase().normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\");\n        t = t.trim();\n        if (t.includes(\"sofia\")) args.terapeuta = \"Sofía\";\n        else if (t.includes(\"angela\")) args.terapeuta = \"Ángela\";\n        else if (t.includes(\"ruth\") || t.includes(\"rut\") || t.includes(\"rus\") || t.includes(\"ruts\")) args.terapeuta = \"Ruth\";\n        else if (t.includes(\"marta\")) args.terapeuta = \"Marta\";\n        else if (t.includes(\"laura\")) args.terapeuta = \"Laura\";\n        else if (t.includes(\"yaiza\")) args.terapeuta = \"Yaiza\";\n        else if (t.includes(\"zoe\")) args.terapeuta = \"Zoe\";\n      }\n\n      // Renombramos los argumentos a 'args' para que el Switch lo pueda leer sin alarmas\n      toolCall.function.args = args;\n      \n      // Subimos la acción al panel principal\n      if (!newItem.body) newItem.body = {};\n      newItem.body.accion = args.accion;\n    }\n  } catch (err) {}\n  newItems.push({ json: newItem });\n}\nreturn newItems;"
      },
