              "value": "=({{ (function(){\n  const args = $('Bypass Sec Vapi').first().json.body.message?.toolCalls?.[0]?.function?.args || {};\n  const full = args.nombre_niño || '';\n  if (!full.trim()) return 'id.eq.00000000-0000-0000-0000-000000000000';\n  \n  const parts = full.trim().split(/\\s+/);\n  const first = parts[0].toLowerCase().normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\");\n  const firstPattern = first.replace(/a/g, '[aáàäâ]').replace(/e/g, '[eéèëê]').replace(/i/g, '[iíìïî]').replace(/o/g, '[oóòöô]').replace(/u/g, '[uúùüû]');\n  \n  if (parts.length === 1) {\n    return `first_name.imatch.${firstPattern}`;\n  }\n  \n  const last = parts.slice(1).join(' ').toLowerCase().normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\");\n  const lastPattern = last.replace(/a/g, '[aáàäâ]').replace(/e/g, '[eéèëê]').replace(/i/g, '[iíìïî]').replace(/o/g, '[oóòöô]').replace(/u/g, '[uúùüû]');\n  \n  return `and(first_name.imatch.${firstPattern},last_name.imatch.${lastPattern})`;\n})() }})"
