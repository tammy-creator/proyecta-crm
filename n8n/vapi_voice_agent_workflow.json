    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"reply\": \"{{ (function(){\n  const appt = $('Get Active Appointments').first().json;\n  const patient = $('Get Patient for Cancellation').first().json;\n  if (appt && appt.start_time) {\n    const dateObj = new Date(appt.start_time);\n    const daySp = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'][dateObj.getDay()];\n    const hour = dateObj.getHours().toString().padStart(2, '0') + ':' + dateObj.getMinutes().toString().padStart(2, '0');\n    return `He tomado nota de tu solicitud para cancelar la próxima cita de ${patient.first_name || 'su hijo'} del ${daySp} a las ${hour} con ${appt.therapist_name || 'su terapeuta'}. El equipo de administración procederá a cancelarla y te contactará para confirmártelo.`;\n  }\n  return `He tomado nota de tu aviso de cancelación para ${patient.first_name || 'su hijo'}. No he localizado ninguna cita activa en la agenda virtual, pero la administración revisará tu caso manualmente hoy mismo y te confirmarán el estado.`;\n})() }}\"\n}",
        "options": {}
      },
      "id": "webhook-response-cancel",
      "name": "Respond Cancelacion",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1220,
        560
      ]
    },
